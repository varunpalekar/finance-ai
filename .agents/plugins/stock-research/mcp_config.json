{
  "mcpServers": {
    "screener": {
      "command": "uvx",
      "args": [
        "--with",
        "screener-mcp[ai]",
        "--with",
        "pdfplumber",
        "screener-mcp"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "yfinance": {
      "command": "uvx",
      "args": [
        "yfmcp@latest"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": [
        "mcp",
        "--tools",
        "all"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "tijori-finance": {
      "command": "npx",
      "args": [
        "-y",
        "-s",
        "github:varunpalekar/finance-ai#main"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
        "NODE_ENV": "production"
      }
    }
  }
}
