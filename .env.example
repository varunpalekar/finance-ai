# ==============================================================================
# finance-ai Environment Configuration Template
# ==============================================================================

# Tijori Finance Credentials (Used by "npm run auth" to generate output/session.json)
TIJORI_EMAIL=your_email@example.com
TIJORI_PASSWORD=your_password
# Optional: Override default session path (~/output/session.json)
# TIJORI_SESSION_PATH=

# Perplexity Finance (Used by "npm run auth:pplx" to generate output/perplexity_session.json)
# Optional: Override default Perplexity session path
# PERPLEXITY_SESSION_PATH=

# Screener.in Credentials (Optional: for premium concall transcripts / Excel export)
# SCREENER_USERNAME=your_screener_username
# SCREENER_PASSWORD=your_screener_password
