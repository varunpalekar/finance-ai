{
  "name": "finance-ai",
  "version": "1.0.0",
  "mcpName": "io.github.varunpalekar/finance-ai",
  "type": "module",
  "description": "Enterprise-grade Quad-MCP equity research engine: Tijori Finance, Perplexity Finance, Screener.in, and Yahoo Finance for AI agents.",
  "author": "Varun Palekar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/varunpalekar/finance-ai.git"
  },
  "main": "src/index.js",
  "bin": {
    "finance-ai": "./src/index.js",
    "tijori-finance": "./src/index.js",
    "tijori-finance-mcp": "./src/index.js"
  },
  "scripts": {
    "setup": "node setup.js",
    "auth": "node scripts/auth.js",
    "reauth": "node scripts/auth.js --reauth",
    "auth:pplx": "node scripts/auth-perplexity.js",
    "reauth:pplx": "node scripts/auth-perplexity.js --reauth",
    "status:pplx": "node scripts/auth-perplexity.js --status",
    "daemon:pplx": "node scripts/auth-perplexity.js --daemon",
    "record:pplx": "node scripts/record-perplexity-fixtures.js",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "test:live": "node --test test/live.test.js",
    "test:pplx": "node --test test/perplexity-live.test.js"
  },
  "keywords": [
    "mcp",
    "finance",
    "india",
    "stocks",
    "tijori",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  }
}
